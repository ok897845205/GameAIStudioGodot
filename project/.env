# Bundled first-run update configuration. The server can replace this at
# runtime by sending nextEnv in update.json; the app writes it to userData/update.env.
#
# IP direct mode avoids DNS/proxy issues. It intentionally uses HTTP, so it
# must opt in explicitly. The downloaded installer is still checked by sha256.
GAMEAISTUDIO_UPDATE_MANIFEST_URL=http://101.33.218.121:6780/gameaistudio/update.json
GAMEAISTUDIO_UPDATE_CHANNEL=stable
GAMEAISTUDIO_UPDATE_ALLOW_INSECURE=true
