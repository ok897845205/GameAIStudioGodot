# Bundled first-run update configuration.
GAMEAISTUDIO_UPDATE_MANIFEST_URL=https://your-update-host.example.com/gameaistudio/update.json
GAMEAISTUDIO_UPDATE_CHANNEL=stable

# Set to true only when the update manifest and installer use explicit HTTP.
# The installer is still verified by sha256 from update.json.
GAMEAISTUDIO_UPDATE_ALLOW_INSECURE=false
